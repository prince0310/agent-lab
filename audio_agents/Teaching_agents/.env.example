GOOGLE_API_KEY=your_google_api_key_here

# Override the Live model (default: gemini-2.0-flash-live-001)
TEACHING_LIVE_MODEL=gemini-3.8-live

# Female voices: Kore, Aoede, Leda, Zephyr
# Male voices: Puck, Charon, Fenrir
TEACHING_VOICE=Kore

# Language / accent (en-IN = Indian English, en-US = American, en-GB = British)
TEACHING_LANGUAGE=en-IN

PORT=8000
